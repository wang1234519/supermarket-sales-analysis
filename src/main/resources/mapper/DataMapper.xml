<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.supermarket.mapper.DataMapper">

    <!-- 表名只允许 Service 层白名单中的值，使用 ${} 动态拼接 -->
    <select id="selectRows" resultType="map">
        SELECT *
        FROM ${table}
        LIMIT #{offset}, #{size}
    </select>

    <select id="countRows" resultType="long">
        SELECT COUNT(*)
        FROM ${table}
    </select>
</mapper>
